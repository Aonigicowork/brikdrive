# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Cloud OAuth Configuration (Scope: https://www.googleapis.com/auth/drive.file)
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/drive-connection/callback

# Security & Encryption Key (32-byte / 64-hex-char server key for envelope encryption)
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# App & Cron URL
APP_URL=http://localhost:3000
CRON_SECRET=your-secure-random-cron-secret-string
