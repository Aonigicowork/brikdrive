# ==============================================================================
# BrikDrive Environment Variables Template
# ==============================================================================

# 1. Supabase Configuration (Auth & Database PostgreSQL RLS)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. Google Cloud OAuth & Drive API (Scope: https://www.googleapis.com/auth/drive.file)
# Dapatkan dari: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 3. Security & Envelope Encryption (AES-256-GCM)
# Kunci 32-byte (64 hex characters), generate via: openssl rand -hex 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. App URL & OAuth Redirect URI
# Untuk Lokal:
APP_URL=http://localhost:3000
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/drive-connection/callback

# Untuk Vercel / Production (Ubah di Vercel Environment Variables):
# APP_URL=https://your-app.vercel.app
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/v1/drive-connection/callback

# 5. Background Cron Secret
CRON_SECRET=your-secure-random-cron-secret-string
